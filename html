    <div class="container">
        <!-- ملخص سريع -->
        <div class="summary-card">
            <div class="card">
                <h4>إجمالي الإيرادات</h4>
                <p class="highlight">39,600.00 د.إ</p>
            </div>
            <div class="card">
                <h4>المصروفات الثابتة</h4>
                <p class="highlight">15,920.09 د.إ</p>
            </div>
            <div class="card">
                <h4>المصروفات المتغيرة</h4>
                <p class="highlight">4,057.00 د.إ</p>
            </div>
            <div class="card">
                <h4>إجمالي المصروفات</h4>
                <p class="highlight">19,977.09 د.إ</p>
            </div>
            <div class="card">
                <h4>صافي الربح قبل الضريبة</h4>
                <p class="highlight profit">19,622.91 د.إ</p>
            </div>
            <div class="card">
                <h4>الضريبة (5%)</h4>
                <p class="highlight">1,980.00 د.إ</p>
            </div>
            <div class="card">
                <h4>صافي الربح بعد الضريبة</h4>
                <p class="highlight profit">17,642.91 د.إ</p>
            </div>
        </div>

        <!-- قسم الفلترة -->
        <div class="filter-section">
            <h3>فلترة البيانات</h3>
            <label for="dataType">نوع البيانات:</label>
            <select id="dataType" onchange="updateCharts()">
                <option value="revenues">إيرادات الحفلات</option>
                <option value="expenses">المصروفات الثابتة</option>
                <option value="variableExpenses">المصروفات المتغيرة</option>
            </select>
        </div>

        <!-- الرسوم البيانية -->
        <div class="chart-container">
            <h3 id="chartTitle">توزيع الإيرادات والمصروفات</h3>
            <canvas id="mainChart"></canvas>
        </div>

        <div class="chart-container">
            <h3>المقارنة بين الإيرادات والمصروفات</h3>
            <canvas id="comparisonChart"></canvas>
        </div>

        <!-- جدول تفاصيل الإيرادات -->
        <div class="chart-container">
            <h3>تفاصيل الإيرادات</h3>
            <table id="revenueTable">
                <thead>
                    <tr>
                        <th>مسلسل</th>
                        <th>اسم العميل</th>
                        <th>مكان الحفل</th>
                        <th>قيمة العقد</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td>حمد خميس إبراهيم</td>
                        <td>أبوظبي</td>
                        <td>32,100.00</td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>منى محمد الظاهر</td>
