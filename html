                        <td>تقديم ضريبة الشركة</td>
                    </tr>
                    <tr>
                        <td>6</td>
                        <td>27/2/2026</td>
                        <td>100.00</td>
                        <td>تبديل أويل + فيلتر</td>
                    </tr>
                    <tr>
                        <td>7</td>
                        <td>28/2/2026</td>
                        <td>1,000.00</td>
                        <td>نسبة مبيعات</td>
                    </tr>
                    <tr>
                        <td>8</td>
                        <td>28/2/2026</td>
                        <td>2,077.00</td>
                        <td>نسبة مبيعات</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <script>
        // البيانات المالية
        const totalRevenue = 39600.00;
        const fixedExpenses = 15920.09;
        const variableExpenses = 4057.00;
        const totalExpenses = fixedExpenses + variableExpenses;
        const grossProfit = totalRevenue - totalExpenses;
        const tax = 1980.00; // 5% من الإيرادات
        const netProfit = grossProfit - tax;

        // تحديث الرسوم البيانية
        const mainCtx = document.getElementById('mainChart').getContext('2d');
        const comparisonCtx = document.getElementById('comparisonChart').getContext('2d');

        let mainChart, comparisonChart;

        // رسم توزيع الإيرادات والمصروفات
        function renderRevenuesChart() {
            const data = {
                labels: ['إيرادات', 'مصروفات ثابتة', 'مصروفات متغيرة'],
                datasets: [{
                    data: [totalRevenue, fixedExpenses, variableExpenses],
                    backgroundColor: [
                        'rgba(75, 192, 192, 0.7)',
                        'rgba(255, 99, 132, 0.7)',
                        'rgba(255, 206, 86, 0.7)'
                    ],
                    borderWidth: 1
                }]
            };

            if (mainChart) mainChart.destroy();

            mainChart = new Chart(mainCtx, {
                type: 'pie',
                data: data,
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'right' },
                        datalabels: {
                            formatter: (value, ctx) => {
                                const total = ctx.chart.data.datasets[0].data.reduce((a, b) => a + b, 0);
                                const percentage = Math.round((value / total) * 100);
                                return `${percentage}%`;
                            },
                            color: getComputedStyle(document.body).getPropertyValue('--text-color'),
                            font: {
                                weight: 'bold'
                            }
                        }
                    }
                },
                plugins: [ChartDataLabels]
            });
        }

        // رسم توزيع المصروفات الثابتة
        function renderFixedExpensesChart() {
            const fixedExpensesData = [
                { label: 'رواتب', value: 13679.31 },
                { label: 'موبيل', value: 736.34 },
                { label: 'تنظيف', value: 305.00 },
                { label: 'عمالة', value: 1200.44 }
            ];

            const data = {
                labels: fixedExpensesData.map(item => item.label),
                datasets: [{
                    data: fixedExpensesData.map(item => item.value),
                    backgroundColor: [
                        'rgba(255, 99, 132, 0.7)',
                        'rgba(54, 162, 235, 0.7)',
                        'rgba(255, 206, 86, 0.7)',
                        'rgba(75, 192, 192, 0.7)'
                    ],
                    borderWidth: 1
                }]
            };

            if (mainChart) mainChart.destroy();

            mainChart = new Chart(mainCtx, {
                type: 'pie',
                data: data,
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'right' },
                        datalabels: {
                            formatter: (value, ctx) => {
                                const total = ctx.chart.data.datasets[0].data.reduce((a, b) => a + b, 0);
                                const percentage = Math.round((value / total) * 100);
                                return `${percentage}%`;
                            },
                            color: getComputedStyle(document.body).getPropertyValue('--text-color'),
                            font: {
                                weight: 'bold'
                            }
                        }
                    }
                },
                plugins: [ChartDataLabels]
            });
        }

        // رسم توزيع المصروفات المتغيرة
        function renderVariableExpensesChart() {
            const variableExpensesData = [
                { label: 'بترول', value: 380.00 },
                { label: 'ضريبة', value: 500.00 },
                { label: 'نسبة مبيعات', value: 3077.00 }
            ];

            const data = {
                labels: variableExpensesData.map(item => item.label),
                datasets: [{
                    data: variableExpensesData.map(item => item.value),
                    backgroundColor: [
                        'rgba(255, 99, 132, 0.7)',
                        'rgba(54, 162, 235, 0.7)',
                        'rgba(255, 206, 86, 0.7)'
                    ],
                    borderWidth: 1
                }]
            };

            if (mainChart) mainChart.destroy();

            mainChart = new Chart(mainCtx, {
                type: 'pie',
                data: data,
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'right' },
                        datalabels: {
                            formatter: (value, ctx) => {
                                const total = ctx.chart.data.datasets[0].data.reduce((a, b) => a + b, 0);
                                const percentage = Math.round((value / total) * 100);
                                return `${percentage}%`;
                            },
                            color: getComputedStyle(document.body).getPropertyValue('--text-color'),
                            font: {
                                weight: 'bold'
                            }
                        }
                    }
                },
                plugins: [ChartDataLabels]
            });
        }

        // رسم مقارنة الإيرادات والمصروفات
        function renderComparisonChart() {
            const data = {
                labels: ['إيرادات', 'مصروفات ثابتة', 'مصروفات متغيرة', 'صافي الربح قبل الضريبة', 'صافي الربح بعد الضريبة'],
                datasets: [{
                    label: 'القيمة (د.إ)',
                    data: [totalRevenue, fixedExpenses, variableExpenses, grossProfit, netProfit],
                    backgroundColor: [
                        'rgba(75, 192, 192, 0.7)',
                        'rgba(255, 99, 132, 0.7)',
                        'rgba(255, 206, 86, 0.7)',
                        'rgba(54, 162, 235, 0.7)',
                        'rgba(153, 102, 255, 0.7)'
                    ],
                    borderWidth: 1
                }]
            };

            if (comparisonChart) comparisonChart.destroy();

            comparisonChart = new Chart(comparisonCtx, {
                type: 'bar',
                data: data,
                options: {
                    responsive: true,
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });
        }

        // تحديث الرسوم البيانية
        function updateCharts() {
            const dataType = document.getElementById('dataType').value;
            if (dataType === 'revenues') {
                document.getElementById('chartTitle').textContent = 'توزيع الإيرادات والمصروفات';
                renderRevenuesChart();
            } else if (dataType === 'expenses') {
                document.getElementById('chartTitle').textContent = 'توزيع المصروفات الثابتة';
                renderFixedExpensesChart();
            } else if (dataType === 'variableExpenses') {
                document.getElementById('chartTitle').textContent = 'توزيع المصروفات المتغيرة';
                renderVariableExpensesChart();
            }
            renderComparisonChart();
        }

        // تبديل الوضع الداكن
        function toggleDarkMode() {
            document.body.classList.toggle('dark-mode');
            updateCharts(); // تحديث الرسوم عند تبديل الوضع
        }

        // تهيئة الرسوم عند تحميل الصفحة
        window.onload = function() {
            updateCharts();
        };
    </script>
</body>
</html>