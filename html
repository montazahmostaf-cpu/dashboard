                    </tr>
                    <tr>
                        <td>3</td>
                        <td>راية علي محمد بن وديمة</td>
                        <td>الساد</td>
                        <td>1,500.00</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- جدول تفاصيل المصروفات الثابتة -->
        <div class="chart-container">
            <h3>تفاصيل المصروفات الثابتة</h3>
            <table id="fixedExpensesTable">
                <thead>
                    <tr>
                        <th>مسلسل</th>
                        <th>التاريخ</th>
                        <th>قيمة الفاتورة</th>
                        <th>البيان</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td>15/2/2026</td>
                        <td>2,031.50</td>
                        <td>رواتب شهر 2-2026</td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>24/2/2026</td>
                        <td>9,247.25</td>
                        <td>رواتب شهر 2-2026</td>
                    </tr>
                    <tr>
                        <td>3</td>
                        <td>28/2/2026</td>
                        <td>500.00</td>
                        <td>رواتب شهر 2-2026</td>
                    </tr>
                    <tr>
                        <td>4</td>
                        <td>28/2/2026</td>
                        <td>1,600.00</td>
                        <td>عمالة رواتب شهر 2-2026</td>
                    </tr>
                    <tr>
                        <td>5</td>
                        <td>28/2/2026</td>
                        <td>305.00</td>
                        <td>أغراض تنظيف للشركة عن شهر 1</td>
                    </tr>
                    <tr>
                        <td>6</td>
                        <td>28/2/2026</td>
                        <td>1,500.00</td>
                        <td>عمالة رواتب شهر 2-2026</td>
                    </tr>
                    <tr>
                        <td>7</td>
                        <td>24/3/2026</td>
                        <td>736.34</td>
                        <td>فاتورة موبيل عن شهر 2-2026</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- جدول تفاصيل المصروفات المتغيرة -->
        <div class="chart-container">
            <h3>تفاصيل المصروفات المتغيرة</h3>
            <table id="variableExpensesTable">
                <thead>
                    <tr>
                        <th>مسلسل</th>
                        <th>التاريخ</th>
                        <th>قيمة الفاتورة</th>
                        <th>البيان</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td>2/2/2026</td>
                        <td>100.00</td>
                        <td>بترول سيارة الشركة</td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>20/2/2026</td>
                        <td>150.00</td>
                        <td>بترول مشوار دبي</td>
                    </tr>
                    <tr>
                        <td>3</td>
                        <td>24/2/2026</td>
                        <td>30.00</td>
                        <td>بترول سيارة الشركة</td>
                    </tr>
                    <tr>
                        <td>4</td>
                        <td>25/2/2026</td>
                        <td>100.00</td>
                        <td>بترول سيارة الشركة</td>
                    </tr>
                    <tr>
                        <td>5</td>
                        <td>27/2/2026</td>
